AI_PROVIDER=gemini

# Gemini API key from https://aistudio.google.com/apikey (image models require billing)
GEMINI_API_KEY=

# Optional overrides (can also be changed in the UI Settings tab)
GEMINI_TEXT_MODEL=gemini-3.8-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_TEXT_MODEL=
NINEROUTER_VISION_MODEL=
NINEROUTER_IMAGE_MODEL=

AI_REQUEST_TIMEOUT_MS=120000
AI_MAX_RETRIES=1

# Optional machine-level shared services (disabled by default)
LOCAL_AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_TEXT_MODEL=llama3.2
OLLAMA_VISION_MODEL=
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW=
LOCAL_AI_FALLBACK=false

PORT=5174

# Port of the temporary Wi-Fi share page (QR code for the phone). Only open while sharing.
SHARE_PORT=5175
